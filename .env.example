# ===== Google Cloud OAuth2 =====
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ===== AI Provider (Groq / Gemini) =====
AI_PROVIDER=groq
# Groq (Recommended: fast, 14,400 free req/day)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ===== Gemini AI (Key Rotation Fallback) =====
# Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# GEMINI_API_KEY_3=optional_third_key

# ===== Agent Settings =====
CHECK_INTERVAL_HOURS=3
PORT=3000
MAX_EMAILS_PER_CHECK=15

# ===== Dashboard Security =====
# REQUIRED for production: protect your dashboard with a password
# Anyone visiting your Render URL must enter this password to access the dashboard
DASHBOARD_PASSWORD=your_strong_password_here
SESSION_SECRET=your_long_random_secret_string_here

# ===== Telegram Bot =====
# 1. Message @BotFather on Telegram → /newbot → get your token
# 2. Message your bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Find your chat_id in the response JSON
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ===== Notification Preferences =====
NOTIFY_ON_CRITICAL=true
NOTIFY_ON_HIGH=true
NOTIFY_ON_MEDIUM=false
NOTIFY_ON_LOW=false
